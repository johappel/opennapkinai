{
  "private": true,
  "scripts": {
    "build": "turbo run build --filter=@repo/types",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.ts,tsx,md\"",
    "check:fit": "node --import tsx scripts/audit-layout-fit.mjs",
    "check:data": "node --import tsx scripts/check-diagram-data.mjs",
    "check": "npm run check:fit && npm run check:data"
  },
  "devDependencies": {
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5"
  },
  "name": "opennapkinai",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {}
}