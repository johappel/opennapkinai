# Vorlage fuer lokale Umgebungsvariablen.
# Kopieren nach .env und echte Werte eintragen. Die .env selbst wird nicht committet.

# B.AI (https://api.b.ai), OpenAI-kompatibler Endpunkt.
# Key aus dem B.AI-Konto. Wird im Backend als Provider "bai" verwendet.
BAI_API_KEY=

# Ollama-Host. Ohne Angabe: http://localhost:11434
OLLAMA_HOST=

# Port des Backends. Ohne Angabe: 3001
PORT=
